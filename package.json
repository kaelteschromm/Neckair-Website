{
  "name": "neckair-website",
  "version": "1.0.0",
  "private": true,
  "description": "Website der NECKAIR – Heizung, Sanitär & Trinkwasser, Klima & Kälte",
  "scripts": {
    "images": "node scripts/optimize-images.mjs",
    "predev": "npm run images",
    "dev": "next dev",
    "prebuild": "npm run images",
    "build": "next build",
    "start": "node scripts/serve-out.mjs",
    "typecheck": "tsc --noEmit",
    "postbuild": "node scripts/flatten-segments.mjs",
    "lint": "eslint .",
    "test": "node --test tests/unit/",
    "test:e2e": "playwright test",
    "serve": "node scripts/serve-out.mjs",
    "bundle-report": "node scripts/bundle-report.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run bundle-report && npm run test:e2e"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "motion": "^12.23.0",
    "next": "^16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.187.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "three-gpu-pathtracer": "^0.0.28",
    "three-mesh-bvh": "^0.9.18",
    "typescript": "^5.8.0",
    "xatlas-web": "^0.1.0"
  }
}
